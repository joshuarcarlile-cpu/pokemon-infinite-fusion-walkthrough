  "wiki_ground_truth": {
    "Route 42": {
      "canonical_slug": "Route_42",
      "lead_summary": "Route 42 is a route that connects Ecruteak City to Mahogany Town. Mt. Mortar can be accessed from either side.\nThe player needs both Surf and Cut (or their HM Replacement Item) to traverse it.",
      "items": [
        {
          "internal_id": "HARDSTONE",
          "quantity": "",
          "name": "Hard Stone",
          "location_details": "Given by Hiker Benjamin after defeating him."
        }
      ],
      "missable_warnings": []
    },
    "Mt. Mortar": {
      "canonical_slug": "Mt._Mortar",
      "lead_summary": "Mt. Mortar is a dark cave that can only be accessed from Route 42.\nOn a small island at the top of the Waterfall there will be a random Pokémon as a static encounter. After fighting it, another will appear after 7 days.",
      "items": [
        {
          "internal_id": "METALCOAT",
          "quantity": "",
          "name": "Metal Coat",
          "location_details": "West, on top of the upper waterfall."
        },
        {
          "internal_id": "PROTECTOR",
          "quantity": "",
          "name": "Protector",
          "location_details": "On the ground, North of the west entrance."
        },
        {
          "internal_id": "STRANGEPRISM",
          "quantity": "",
          "name": "Strange Prism",
          "location_details": "East, below the lower waterfall."
        }
      ],
      "missable_warnings": []
    },
    "Mahogany Town": {
      "canonical_slug": "Mahogany_Town",
      "lead_summary": "fr:Acajou\nMahogany Town is a small town, that is accessed from the North via Route 43, the West via Route 42, and the East via Route 44.\nThis city contains Mahogany Town's Gym, with Pryce as its leader.\nAlthough there is no Poké Mart, the Elderly Woman in the house North of the Gym sells clothes.",
      "items": [
        {
          "internal_id": "FRESHWATER",
          "quantity": "",
          "name": "Fresh Water",
          "location_details": "Given by the man inside the gym."
        }
      ],
      "missable_warnings": []
    },
    "Route 43": {
      "canonical_slug": "Route_43",
      "lead_summary": "Route 43 is a route that connects Mahogany Town to the Lake of Rage.",
      "items": [
        {
          "internal_id": "MAXELIXIR",
          "quantity": "",
          "name": "Max Elixir",
          "location_details": "On a small island on the West side."
        },
        {
          "internal_id": "WISEGLASSES",
          "quantity": "",
          "name": "Wise Glasses",
          "location_details": "On a small island on the North-West side."
        }
      ],
      "missable_warnings": []
    },
    "Lake of Rage": {
      "canonical_slug": "Lake_of_Rage",
      "lead_summary": "The Lake of Rage can be accessed from Route 43.\nThere is a cabin where the player can use the bed to heal its party.\nThere is an icy rock which Colress is inspecting and is looking for a key. It will react to the Light Stone and the Dark Stone, then freeze the lake and prevent the player to exit until Kyurem has been defeated or captured. Touching the Icy rock again will return the lake back to normal",
      "items": [
        {
          "internal_id": "ELECTIRIZER",
          "quantity": "",
          "name": "Electirizer",
          "location_details": "North-East corner."
        }
      ],
      "missable_warnings": []
    }
  },
