  "wiki_ground_truth": {
    "Ilex Forest": {
      "canonical_slug": "Ilex_Forest",
      "lead_summary": "Ilex Forest is twisted path in a dense forest that connects Route 34 to Azalea Town.\nIf the player enters the forest from Route 34 and is not the Pokémon Champion (AKA beat the Elite Four and Rival), the path will be blocked, and a man with its Scyther will be on work chopped trees. If the player has become Pokémon Champion, the man will have created a path through the forest to reach Azalea Town. He will also offer the player to chop small trees, which will raise the player's Karma.\nIf the player enters the gate leading to the forest and is the Pokémon Champion but has not defeated Whitney in Goldenrod City, a passerby will notify them of the reopening of the gym and the player will be unable to progress until Whitney has been beaten.\nIf the player completed at least 50 Quests, the Quest Master will reward the player with a GS Ball, which will allow the capture of Celebi, near the shrine, located near the center of the forest.",
      "items": [],
      "missable_warnings": [
        "NOTE: Contains actions that alter player Karma."
      ]
    },
    "Azalea Town": {
