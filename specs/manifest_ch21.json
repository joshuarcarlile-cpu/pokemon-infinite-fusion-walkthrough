  "wiki_ground_truth": {
    "Water Labyrinth": {
      "canonical_slug": "Water_Labyrinth",
      "lead_summary": "Water Labyrinth is a water route that connects Brine Road (East of the Old Shipwreck) to Resort Gorgeous and Chrono Island.\nThere is an underwater passage leading to the Submerged Temple.",
      "items": [],
      "missable_warnings": []
    },
    "Resort Gorgeous": {
      "canonical_slug": "Resort_Gorgeous",
      "lead_summary": "Resort Gorgeous is a location north of the Water Labyrinth in the Sevii Islands. This location originally appeared in Pokémon Fire Red and Leaf Green. \nSelphy, a wealthy Pokémon Trainer, permanently resides in the resort. She asks the player to show her a fusion between two Pokémon. The fusion she wants to see is random and it changes every in-game day. If the player shows her the fusion she requested, she will give the player a reward. \n<br />",
      "items": [],
      "missable_warnings": []
    },
    "Chrono Island": {
      "canonical_slug": "Chrono_Island",
      "lead_summary": "Chrono Island, also known as Five Island is a small town that can be accessed from the North by the Water Labyrinth.\nTeam Rocket recently establish a Rocket Warehouse within the island's meadow. After defeating them, the harbour's sailor will offer the player to follow Team Plasma's motorboat to P2 Laboratory.",
      "items": [
        {
          "internal_id": "MAXPOTION",
          "quantity": "",
          "name": "Max Potion",
          "location_details": "On the ground in the Meadow."
        }
      ],
      "missable_warnings": []
    },
    "Rocket Warehouse": {
      "canonical_slug": "Rocket_Warehouse",
      "lead_summary": "Rocket Warehouse, also known as Team Rocket Warehouse, is one of the last refuge of Team Rocket, located in the meadow of Chrono Island.\nThere is a static encounter with a Klinklang in the back room.",
      "items": [],
      "missable_warnings": []
    }
  },
